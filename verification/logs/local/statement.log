erdos_104.variants.unitCircumradiusTriples : ∀ (n : ℕ),
  2 ≤ n →
    sSup
        {k |
          ∃ P, P.card = n ∧ ¬LiesOnUnitCircle P ∧ (Finset.filter LiesOnUnitCircle (Finset.powersetCard 3 P)).card = k} =
      if n ≤ 3 then 0 else (n - 1).choose 3 + (n - 2) + if (n - 1) % 3 = 0 then 1 else 0
erdos_104.variants.unitCircumradiusTriplesMaximizer : ∀ (P : Finset (EuclideanSpace ℝ (Fin 2))),
  4 ≤ P.card →
    ¬LiesOnUnitCircle P →
      (Finset.filter LiesOnUnitCircle (Finset.powersetCard 3 P)).card =
          sSup
            {k |
              ∃ Q,
                Q.card = P.card ∧
                  ¬LiesOnUnitCircle Q ∧ (Finset.filter LiesOnUnitCircle (Finset.powersetCard 3 Q)).card = k} →
        ∃ s, s.radius = 1 ∧ {p ∈ P | p ∈ s}.card = P.card - 1
'Erdos104.erdos_104.variants.unitCircumradiusTriples' depends on axioms: [propext, Classical.choice, Quot.sound]
'Erdos104.erdos_104.variants.unitCircumradiusTriplesMaximizer' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
